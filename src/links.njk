---
title: Links
description: earlmade on YouTube, TikTok and Instagram.
permalink: /links.html
eleventyExcludeFromCollections: true
---
{#- A one-screen "link in bio" page. Standalone on purpose: no sidebar, just the links.
    Edit the list in src/_data/site.js (socials). -#}
<!doctype html>
<html lang="en" class="wa-theme-awesome wa-palette-bright wa-light">
<head>
  {% include "partials/head.njk" %}
</head>
<body class="links-page">
  <main class="links-wrap wa-stack wa-gap-2xl">
    <header class="wa-stack wa-gap-xs wa-align-items-center">
      <img src="/assets/earlhead.svg" alt="" class="links-head" eleventy:ignore width="570" height="570">
      <h1 class="wordmark links-wordmark">earlmade</h1>
      <p class="caption">@earlmade on YouTube, TikTok and Instagram</p>
    </header>

    <nav class="wa-stack wa-gap-m" aria-label="Social profiles">
      {%- for s in site.socials %}
      <wa-button href="{{ s.url }}" size="l" appearance="filled-outlined" class="links-button" rel="me noopener" target="_blank">
        <wa-icon slot="start" name="{{ s.icon }}" family="brands"></wa-icon>
        {{ s.label }}
        <span slot="end" class="links-handle">{{ s.handle }}</span>
      </wa-button>
      {%- endfor %}
    </nav>

    <wa-divider></wa-divider>
    <section class="wa-flank wa-gap-l wa-align-items-center links-kickstarter">
      <img
        src="https://prismmtg.com/assets/DarkSpiritGuide.svg"
        alt="The Spirit Guide over a card sleeve, with a mark drawn through one slot of its comb"
        width="396"
        height="440"
      />
      <div class="wa-stack wa-gap-s">
        <h2 class="wa-heading-m">The Kickstarter Campaign</h2>
        <p class="wa-body-s">
          The Spirit Guide, the alignment tool this marking system is built around, is on
          Kickstarter, along with matching sleeves, tokens and playmats. Backing the campaign
          also includes a lifetime PRISM Membership.
        </p>
        <wa-button appearance="accent" variant="brand" href="https://www.kickstarter.com/projects/prismmtg/prism-one-card-every-deck" target="_blank" rel="noopener">
          <wa-icon slot="start" name="kickstarter" family="brands"></wa-icon>
          See it on Kickstarter
        </wa-button>
      </div>
    </section>

    <wa-divider></wa-divider>

    <nav class="wa-stack wa-gap-s" aria-label="On this site">
      <wa-button href="/" appearance="plain" class="links-button">
        <wa-icon slot="start" name="house"></wa-icon>
        The blog
      </wa-button>
      <wa-button href="/library/" appearance="plain" class="links-button">
        <wa-icon slot="start" name="magnifying-glass"></wa-icon>
        The library
      </wa-button>
    </nav>
  </main>
</body>
</html>
