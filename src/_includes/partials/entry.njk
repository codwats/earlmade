{#- One item in the stream. Short things are drawn short: a note has no
    headline, and a link never pretends to be an article. -#}

{% macro meta(item) %}
{%- set d = item.data -%}
{%- if d.shelf or d.tags.length %}
<div class="entry-meta wa-cluster wa-gap-2xs">
  {%- if d.shelf %}
  <a class="tag-link" href="/library/?shelf={{ d.shelf | urlencode }}"><wa-tag size="s" variant="brand">{{ d.shelf }}</wa-tag></a>
  {%- endif %}
  {%- for tag in d.tags %}
  <a class="tag-link" href="/library/?tag={{ tag | urlencode }}"><wa-tag size="s">#{{ tag }}</wa-tag></a>
  {%- endfor %}
</div>
{%- endif %}
{% endmacro %}

{#- A link's thumbnail, on the home stream and in the library.
    The Image transform downloads, optimises and self-hosts `image:`. If that
    fails, a transparent placeholder keeps the slot and the build going.
    With no image, the label tiles at 45° like brickwork: an inline SVG, so it
    takes the page font and colour tokens. Maple Mono is 0.6em wide per character. -#}
{% macro thumb(item) %}
{%- set d = item.data -%}
<div class="entry-thumb">
  {%- if d.image %}
  <img src="{{ d.image }}" alt="" width="1200" height="630" eleventy:optional="placeholder">
  {%- else %}
  {%- set fontSize = 14 %}
  {%- set textWidth = (d.label | length) * fontSize * 0.6 %}
  {%- set tile = textWidth + 24 %}
  {%- set id = "thumb-" + (item.page.inputPath | slugify) %}
  <svg aria-hidden="true" focusable="false" font-size="{{ fontSize }}">
    <defs>
      <pattern id="{{ id }}" width="{{ tile }}" height="56" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
        <text x="0" y="20" textLength="{{ textWidth }}">{{ d.label }}</text>
        <text x="{{ -tile / 2 }}" y="48" textLength="{{ textWidth }}">{{ d.label }}</text>
        <text x="{{ tile / 2 }}" y="48" textLength="{{ textWidth }}">{{ d.label }}</text>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#{{ id }})"></rect>
  </svg>
  {%- endif %}
</div>
{% endmacro %}

{% macro entry(item) %}
{%- set d = item.data -%}
{%- if d.kind == "post" %}
<article class="entry entry-post wa-stack wa-gap-s">
  <p class="entry-kind"><wa-icon name="file-lines"></wa-icon>Post · {{ item.content | readingTime }} min read</p>
  <h3 class="entry-post-title"><a href="{{ item.url }}">{{ d.title }}</a></h3>
  {%- if d.description %}
  <p class="entry-dek">{{ d.description }}</p>
  {%- endif %}
  {{ meta(item) }}
</article>
{%- elif d.kind == "note" %}
<article class="entry entry-note wa-stack wa-gap-xs">
  <div class="entry-note-text">{{ item.content | safe }}</div>
  <p class="entry-kind"><wa-icon name="pen"></wa-icon><a href="{{ item.url }}">Note</a></p>
  {{ meta(item) }}
</article>
{%- else %}
<article class="entry entry-link wa-stack wa-gap-xs">
  {{ thumb(item) }}
  <p class="entry-kind"><wa-icon name="link"></wa-icon>Link</p>
  <h3 class="entry-link-title">
    <a href="{{ d.url }}">{{ d.label }}<wa-icon name="arrow-up-right-from-square" label="external link"></wa-icon></a>
    <span class="domain">{{ d.url | hostname }}</span>
  </h3>
  {%- if item.content | trim %}
  <div class="entry-comment">{{ item.content | safe }}</div>
  {%- endif %}
  {{ meta(item) }}
</article>
{%- endif %}
{% endmacro %}
